import fs from 'node:fs';
import assert from 'node:assert/strict';
import {PGlite} from '@electric-sql/pglite';
import {is} from 'drizzle-orm';
import {getTableConfig,PgTable,PgDialect} from 'drizzle-orm/pg-core';
import * as schema from '../../../src/db/schema';
const folder=process.argv[2];if(!folder)throw new Error('Provide the private snapshot directory.');
const dir=new URL('.',import.meta.url).pathname;const pg=new PGlite();const dialect=new PgDialect();
const quote=(v:unknown):string=>v===null?'null':typeof v==='object'?quote(JSON.stringify(v)):typeof v==='string'?`'${v.replaceAll("'","''")}'`:String(v);
for(const t of Object.values(schema).filter(t=>is(t,PgTable))){const c=getTableConfig(t);const cols=c.columns.map(col=>`"${col.name}" ${col.getSQLType()}${col.notNull?' NOT NULL':''}${col.default!==undefined?' DEFAULT '+(typeof col.default==='object'&&col.default!==null&&'queryChunks' in col.default?dialect.sqlToQuery(col.default as Parameters<typeof dialect.sqlToQuery>[0]).sql:quote(col.default)):''}${col.primary?' PRIMARY KEY':''}${col.isUnique?' UNIQUE':''}`);for(const u of c.uniqueConstraints)cols.push(`UNIQUE (${u.columns.map(x=>`"${x.name}"`).join(',')})`);await pg.exec(`CREATE TABLE "${c.name}" (${cols.join(',')})`);}
const insert=async(t:string,row:Record<string,unknown>)=>{const keys=Object.keys(row);return pg.query(`insert into "${t}" (${keys.map(k=>`"${k}"`).join(',')}) select ${keys.map(k=>`x."${k}"`).join(',')} from jsonb_populate_record(null::"${t}",$1::jsonb) x`,[JSON.stringify(row)]);};
const fixture=JSON.parse(fs.readFileSync(`${folder}/rameeza-merge-preflight.private.json`,'utf8'));
for(const [key,table] of Object.entries({profiles:'sailors',results:'regatta_results',participants:'regatta_result_participants',races:'regatta_race_results',aliases:'sailor_aliases',indexIdentities:'asian_optimist_index_sailors',indexResults:'asian_optimist_index_results'}))for(const row of fixture[key]??[])await insert(table,row);
await pg.exec('alter table regatta_results add foreign key(sailor_id) references sailors(id); alter table regatta_race_results add foreign key(regatta_result_id) references regatta_results(id); alter table regatta_result_participants add foreign key(regatta_result_id) references regatta_results(id); alter table regatta_result_participants add foreign key(sailor_id) references sailors(id);');
const sql=fs.readFileSync(dir+'02-merge-confirmed-rameeza.sql','utf8');const keep='f381d00f-cd7e-4418-98af-04d9bdfe9d7d',source='fa8ca139-1612-4a31-9d30-442d01744644';
const normalize=(rows:Record<string,unknown>[])=>rows.map(row=>Object.fromEntries(Object.entries(row).filter(([key])=>!['sailor_id','updated_at'].includes(key)))).sort((a,b)=>String(a.id).localeCompare(String(b.id)));
const beforeResults=normalize((await pg.query<Record<string,unknown>>('select * from regatta_results')).rows);
const beforeParticipants=normalize((await pg.query<Record<string,unknown>>('select * from regatta_result_participants')).rows);
const beforeRaces=(await pg.query('select * from regatta_race_results order by id')).rows;
const beforeIndex=(await pg.query('select * from asian_optimist_index_results order by id')).rows;
const targetRegatta=fixture.results.find((r:{sailor_id:string})=>r.sailor_id===keep).regatta_id;
await insert('regatta_results',{...fixture.results.find((r:{sailor_id:string})=>r.sailor_id===source),id:'00000000-0000-4000-8000-000000000001',regatta_id:targetRegatta});
await assert.rejects(()=>pg.exec(sql),/Shared official sheet/);await pg.exec('rollback');await pg.query('delete from regatta_results where id=$1',['00000000-0000-4000-8000-000000000001']);
await pg.exec(sql);await pg.exec(sql);
assert.equal((await pg.query('select * from sailors where id=$1',[source])).rows.length,0);
assert.equal((await pg.query('select * from sailors where id=$1',[keep])).rows.length,1);
assert.deepEqual(normalize((await pg.query<Record<string,unknown>>('select * from regatta_results')).rows),beforeResults);
assert.deepEqual(normalize((await pg.query<Record<string,unknown>>('select * from regatta_result_participants')).rows),beforeParticipants);
assert.deepEqual((await pg.query('select * from regatta_race_results order by id')).rows,beforeRaces);
assert.deepEqual((await pg.query('select * from asian_optimist_index_results order by id')).rows,beforeIndex);
assert.equal((await pg.query('select * from regatta_results where sailor_id=$1',[keep])).rows.length,2);
assert.equal((await pg.query('select * from regatta_result_participants where sailor_id=$1',[keep])).rows.length,2);
assert.equal((await pg.query('select * from regatta_race_results')).rows.length,18);
console.log(JSON.stringify({passed:true,confirmedRameezaMerge:true,historicalResultsPreserved:2,raceScoresPreserved:18,participantsPreserved:2,indexEvidenceUnchanged:true,blocksSharedOfficialEntries:true,replay:true}));await pg.close();
