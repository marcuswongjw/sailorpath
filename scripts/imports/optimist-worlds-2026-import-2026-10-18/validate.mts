import fs from 'node:fs';
import assert from 'node:assert/strict';
import {PGlite} from '@electric-sql/pglite';
import {is} from 'drizzle-orm';
import {getTableConfig,PgTable,PgDialect} from 'drizzle-orm/pg-core';
import * as schema from '../../../src/db/schema';
const folder=process.argv[2];if(!folder)throw new Error('Provide the private snapshot directory.');
const dir=new URL('.',import.meta.url).pathname;const pg=new PGlite();const dialect=new PgDialect();
const quote=(v:unknown):string=>v===null?'null':typeof v==='object'?quote(JSON.stringify(v)):typeof v==='string'?`'${v.replaceAll("'","''")}'`:String(v);
for(const t of Object.values(schema).filter(t=>is(t,PgTable))){const c=getTableConfig(t);const cols=c.columns.map(col=>`"${col.name}" ${col.getSQLType()}${col.notNull?' NOT NULL':''}${col.default!==undefined?' DEFAULT '+(typeof col.default==='object'&&col.default!==null&&'queryChunks' in col.default?dialect.sqlToQuery(col.default as Parameters<typeof dialect.sqlToQuery>[0]).sql:quote(col.default)):''}${col.primary?' PRIMARY KEY':''}${col.isUnique?' UNIQUE':''}`);for(const u of c.uniqueConstraints)cols.push(`UNIQUE (${u.columns.map(x=>`"${x.name}"`).join(',')})`);await pg.exec(`CREATE TABLE "${c.name}" (${cols.join(',')})`);}
const insert=async(t:string,row:Record<string,unknown>)=>{const keys=Object.keys(row);return pg.query(`insert into "${t}" (${keys.map(k=>`"${k}"`).join(',')}) select ${keys.map(k=>`x."${k}"`).join(',')} from jsonb_populate_record(null::"${t}",$1::jsonb) x`,[JSON.stringify(row)]);};
for(const [key,table] of Object.entries({sailors:'sailors',aliases:'sailor_aliases'}))for(const row of JSON.parse(fs.readFileSync(`${folder}/${key}.private.json`,'utf8')))await insert(table,row);
for(const row of JSON.parse(fs.readFileSync(`${folder}/corroboration.private.json`,'utf8')).index)await insert('asian_optimist_index_sailors',row);
await pg.exec('alter table regattas add foreign key(event_id) references regatta_events(id); alter table regatta_results add foreign key(sailor_id) references sailors(id); alter table regatta_results add foreign key(regatta_id) references regattas(id); alter table regatta_race_results add foreign key(regatta_result_id) references regatta_results(id); alter table regatta_result_participants add foreign key(regatta_result_id) references regatta_results(id); alter table regatta_result_participants add foreign key(sailor_id) references sailors(id);');
const before=(await pg.query<Record<string,unknown>>('select * from sailors order by id')).rows;
const aliases=(await pg.query('select * from sailor_aliases order by id')).rows;
const m=JSON.parse(fs.readFileSync(dir+'overall-2026.json','utf8'));const sql=fs.readFileSync(dir+'01-import-worlds-asian-subset.sql','utf8');
await insert('regatta_events',{id:m.event.id,name:m.event.name,slug:m.event.slug,start_date:m.event.startDate,end_date:m.event.endDate,classes:['Optimist']});
await assert.rejects(()=>pg.exec(sql),/New parent event collision/);await pg.exec('rollback');await pg.query('delete from regatta_events where id=$1',[m.event.id]);
const duplicate=sql.replace(`"sailorId":"${m.results[0].sailorId}"`,`"sailorId":"${m.results[1].sailorId}"`);
await assert.rejects(()=>pg.exec(duplicate),/Separate individual entries cannot share/);await pg.exec('rollback');
const original=m.profilePreflight[0];await pg.query("update sailors set name=name||' changed' where id=$1",[original.id]);await assert.rejects(()=>pg.exec(sql),/identity preflight changed/);await pg.exec('rollback');await pg.query('update sailors set name=$2 where id=$1',[original.id,original.name]);
const invalid=sql.replace(`"rank":${m.results[0].rank},`,`"rank":176,`);await assert.rejects(()=>pg.exec(invalid),/Pending identity or country scope/);await pg.exec('rollback');
await pg.exec(sql);
const results=(await pg.query<Record<string,unknown>>('select * from regatta_results order by id')).rows;
const races=(await pg.query<Record<string,unknown>>('select * from regatta_race_results order by id')).rows;
const participants=(await pg.query<Record<string,unknown>>('select * from regatta_result_participants order by id')).rows;
await pg.exec(sql);
assert.deepEqual((await pg.query('select * from regatta_results order by id')).rows,results);assert.deepEqual((await pg.query('select * from regatta_race_results order by id')).rows,races);assert.deepEqual((await pg.query('select * from regatta_result_participants order by id')).rows,participants);
assert.equal(results.length,44);assert.equal(races.length,528);assert.equal(participants.length,44);
for(const r of m.results){const a=results.find(x=>x.id===r.resultId)!;assert.equal(a.sailor_id,r.sailorId);assert.equal(a.entry_sail_number,r.sailOrBoardNumber);assert.equal(a.evidence_url,m.officialSource.url);assert.equal(a.nationality,r.nationality);assert.equal(a.rank,r.rank);assert.equal(a.total_score,r.grossScore);assert.equal(a.nett_score,r.nettScore);for(const race of r.races){const x=races.find(x=>x.regatta_result_id===r.resultId&&x.race_number===race.raceNumber)!;assert.equal(x.score,race.score);assert.equal(x.scoring_code,race.code);assert.equal(x.discarded,race.discarded);assert.equal(x.raw_value,race.raw);}}
for(const p of before)assert.deepEqual((await pg.query('select * from sailors where id=$1',[p.id])).rows[0],p);
assert.equal((await pg.query<{n:number}>('select count(*)::int n from sailors')).rows[0].n,before.length+8);
assert.deepEqual((await pg.query('select * from sailor_aliases order by id')).rows,aliases);
assert.equal((await pg.query<{counts_for_ranking:boolean}>('select counts_for_ranking from regattas where id=$1',[m.sheet.id])).rows[0].counts_for_ranking,false);
console.log(JSON.stringify({passed:true,parentEvents:1,publishedSheets:1,entries:44,raceScores:528,newProfiles:8,existingProfilesReused:36,replay:true,blocksSharedIndividualIdentity:true,blocksChangedIdentity:true,blocksEventCollision:true,blocksPendingIdentityAndCountryScope:true,allExistingProfileFieldsPreserved:true,aliasesUnchanged:true,sourceCodesDiscardsAndEvidencePreserved:true}));
const fixture=JSON.parse(fs.readFileSync(`${folder}/rameeza-merge-preflight.private.json`,'utf8'));
for(const r of fixture.results)await insert('regattas',{id:r.regatta_id,name:r.regatta_id,slug:r.regatta_id,date:'2025-01-01',total_fleet_size:170});
for(const [key,table] of Object.entries({results:'regatta_results',participants:'regatta_result_participants',races:'regatta_race_results',indexResults:'asian_optimist_index_results'}))for(const row of fixture[key]??[])await insert(table,row);
await pg.exec(fs.readFileSync(dir+'02-merge-confirmed-rameeza.sql','utf8'));
const complete=fs.readFileSync(dir+'03-complete-confirmed-identities.sql','utf8');await pg.exec(complete);await pg.exec(complete);
const final=JSON.parse(fs.readFileSync(dir+'final-overall-2026.json','utf8'));
const finalResults=(await pg.query<Record<string,unknown>>('select * from regatta_results where regatta_id=$1',[final.sheet.id])).rows;
assert.equal(finalResults.length,46);
assert.equal((await pg.query('select * from regatta_race_results x join regatta_results r on r.id=x.regatta_result_id where r.regatta_id=$1',[final.sheet.id])).rows.length,552);
for(const r of final.results){const result=finalResults.find(x=>x.id===r.resultId)!;assert.equal(result.sailor_id,r.sailorId);assert.equal(result.rank,r.rank);assert.equal(result.total_score,r.grossScore);assert.equal(result.nett_score,r.nettScore);const values=(await pg.query<Record<string,unknown>>('select * from regatta_race_results where regatta_result_id=$1 order by race_number',[r.resultId])).rows;for(const [i,x] of values.entries()){assert.equal(x.score,r.races[i].score);assert.equal(x.raw_value,r.races[i].raw);assert.equal(x.scoring_code,r.races[i].code);assert.equal(x.discarded,r.races[i].discarded);}}
assert.equal((await pg.query('select * from regatta_results where sailor_id=$1',['f381d00f-cd7e-4418-98af-04d9bdfe9d7d'])).rows.length,3);
assert.equal((await pg.query('select * from sailors')).rows.length,before.length+9-1);
console.log(JSON.stringify({passed:true,completedAsianEntries:46,completedRaceScores:552,onlyAsianNewProfiles:9,existingProfilesReused:37,duplicateProfilesMerged:1,confirmedSeparateMuranakaProfiles:true,completionReplay:true,allOfficialValuesPreserved:true}));await pg.close();
